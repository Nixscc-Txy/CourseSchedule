<?xml version="1.0" encoding="utf-8"?>
<!-- API 30 及以下的备份规则 (API 31+ 见 data_extraction_rules.xml) -->
<full-backup-content>
    <!--
      App 的数据很少: 导入的课表、选课结果、学期起始日/主题设置。
      全部参与云备份, 换机时能自动恢复。这里显式写出来, 不依赖"默认全备"的隐式行为。
    -->
    <include domain="sharedpref" path="." />
    <include domain="file" path="." />
</full-backup-content>
